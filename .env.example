# Node server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
FRONTEND_DIR=front-end

# DeepSeek chat provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# TTS
# The Node server exposes /api/tts/stream (SSE) and /api/tts (whole WAV).
# TTS_SPEAKER and TTS_LANGUAGE set the initial voice and language; the
# front-end selectors can override both per browser.
# The MLX sidecar has its own variables; see server-voz/README.md.
TTS_PROVIDER=qwen
TTS_URL=http://127.0.0.1:8880
TTS_SPEAKER=Serena
TTS_LANGUAGE=portuguese
TTS_TIMEOUT_MS=45000

# MongoDB (resumos de aprendizagem)
# No Docker Compose o host "mongo" é usado automaticamente.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=socrates
